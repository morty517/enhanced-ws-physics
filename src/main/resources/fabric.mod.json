{
	"schemaVersion": 1,
	"id": "realistic-water",
	"version": "${version}",
	"name": "Enhanced WS Physics",
	"description": "Enhanced WS (Water & Sand) Physics. Modified version (not the original) of Skaffy's Realistic Water (https://github.com/sskaffy/Realistic-Water): OpenGL port for 1.21.8 with extra materials, lava, breakable solids and a grab tool.",
	"authors": [
		"Skaffy (original mod)",
		"morty517 (fork)",
		"Claude by Anthropic (fork code)"
	],
	"contact": {
		"sources": "https://github.com/sskaffy/Realistic-Water"
	},
	"license": "Custom License",
	"icon": "assets/realistic-water/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"me.skaffy.RealisticWater"
		],
		"client": [
			"me.skaffy.client.RealisticWaterClient"
		]
	},
	"mixins": [
		"realistic-water.mixins.json",
		{
			"config": "realistic-water.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.8",
		"java": ">=21",
		"fabric-api": "*"
	}
}