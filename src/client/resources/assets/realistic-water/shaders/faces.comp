#version 430 core
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer Accum { int accum[]; };
layout(std430, binding = 2) writeonly buffer Vel { float vel[]; };
layout(std430, binding = 3) writeonly buffer VelOld { float velOld[]; };
layout(std430, binding = 4) writeonly buffer Valid { uint valid[]; };
layout(std430, binding = 5) readonly buffer Flags { uint cellFlags[]; };
layout(std430, binding = 6) readonly buffer Couple { int couple[]; };

float grainVel(ivec3 c, int comp) {
    int k = cellIndex(c) * 4;
    int n = couple[k];
    return n > 0 ? float(couple[k + 1 + comp]) / COUPLE_FP / float(n) : 0.0;
}

uint flagsAt(ivec3 c) {
    return inBox(c) ? cellFlags[cellIndex(c)] : CELL_AIR;
}

void main() {
    int comp;
    ivec3 f;
    if (!boxFace(int(GID_U), comp, f)) {
        return;
    }
    int i = faceIndex(comp, f);

    int m = accum[2 * i];
    int w = accum[2 * i + 1];
    float u = w > 0 ? float(m) / float(w) : 0.0;
    velOld[i] = u;
    u += getAxis(G.gravityDt.xyz, comp) * DT;

    uint fa = flagsAt(f - axisVec(comp));
    uint fb = flagsAt(f);
    uint ok = w > 0 ? 1u : 0u;
    if ((fa & 0xFFu) == CELL_SOLID || (fb & 0xFFu) == CELL_SOLID) {
        int ea = int((fa >> 8) & 0xFFu) - 1;
        int eb = int((fb >> 8) & 0xFFu) - 1;
        int e = ea >= 0 ? ea : eb;
        if (e >= 0) {
            u = getAxis(entVel(e), comp);
        } else if ((fa & CELL_GRANULAR_BIT) != 0u) {
            u = grainVel(f - axisVec(comp), comp);
        } else if ((fb & CELL_GRANULAR_BIT) != 0u) {
            u = grainVel(f, comp);
        } else {
            u = 0.0;
        }
        ok = 1u;
    }
    vel[i] = u;
    valid[i] = ok;
}
