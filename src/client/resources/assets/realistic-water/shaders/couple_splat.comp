#version 430 core
#include "common.glsl"
// Granular -> fluid coupling: bins the particles of a granular region (MPM) into the cells of a fluid region.
// G is the fluid region's globals; the push block maps granular cell coordinates into fluid cell coordinates.
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer Src { Particle src[]; };
layout(std430, binding = 2) readonly buffer SrcCounters { uint srcCounters[]; };
layout(std430, binding = 3) buffer Couple { int couple[]; };
// a.x = live-count index in srcCounters; b.xyz = granular origin in fluid cells, b.w = fluid res / granular res
layout(std140, binding = 7) uniform PC { ivec4 a; vec4 b; } pc;

void main() {
    uint i = GID_U;
    if (i >= srcCounters[pc.a.x]) {
        return;
    }
    Particle p = src[i];
    if (p.pos.w < 0.0) {
        return;
    }
    ivec3 c = ivec3(floor(pc.b.xyz + p.pos.xyz * pc.b.w));
    if (!inBox(c)) {
        return;
    }
    int k = cellIndex(c) * 4;
    vec3 v = p.vel.xyz * pc.b.w;
    atomicAdd(couple[k], 1);
    atomicAdd(couple[k + 1], int(round(v.x * COUPLE_FP)));
    atomicAdd(couple[k + 2], int(round(v.y * COUPLE_FP)));
    atomicAdd(couple[k + 3], int(round(v.z * COUPLE_FP)));
}
