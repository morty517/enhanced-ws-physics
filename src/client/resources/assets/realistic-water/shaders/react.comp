#version 430 core
#include "common.glsl"
// Lava <-> water. Lava and water run as separate simulations that don't push each other; where their particles overlap they
// react instead: lava particles solidify (counted per cell, the host turns blocks with enough of it into stone) and water
// particles boil away into steam (spray in the water's whitewater).
// G is the globals of the region whose particles this dispatch walks ("own"); "other" is the partner region.
layout(local_size_x = 256) in;
layout(std430, binding = 1) buffer Parts { Particle parts[]; };
layout(std430, binding = 2) buffer Counters { uint counters[]; };
layout(std430, binding = 3) readonly buffer Other { int otherCount[]; };
layout(std430, binding = 4) buffer Solidify { int solidify[]; };
layout(std430, binding = 5) writeonly buffer Steam { Particle steam[]; };
// a.x = live-count index, a.y = whitewater counter index (water mode), a.z = mode (0 lava solidifies, 1 water boils), a.w = seed
// b.xyz = own origin in other cells, b.w = other res / own res; c.xyz = other grid size, c.w = chance per particle and frame
layout(std140, binding = 7) uniform PC { ivec4 a; vec4 b; vec4 c; } pc;

void main() {
    uint i = GID_U;
    if (i >= counters[pc.a.x]) {
        return;
    }
    Particle p = parts[i];
    if (p.pos.w < 0.0) {
        return;
    }
    ivec3 oc = ivec3(floor(pc.b.xyz + p.pos.xyz * pc.b.w));
    ivec3 od = ivec3(pc.c.xyz);
    if (any(lessThan(oc, ivec3(0))) || any(greaterThanEqual(oc, od))) {
        return;
    }
    if (otherCount[oc.x + od.x * (oc.y + od.y * oc.z)] <= 0) {
        return;
    }
    uint seed = hash(i * 2654435761u + uint(pc.a.w) * 97u);
    if (rand(seed) >= pc.c.w) {
        return;
    }
    parts[i].pos.w = -1.0;
    if (pc.a.z == 0) {
        ivec3 c = ivec3(floor(p.pos.xyz));
        if (inGrid(c)) {
            atomicAdd(solidify[cellIndex(c)], 1);
        }
    } else {
        uint o = atomicAdd(counters[pc.a.y], 1u);
        if (o < uint(G.caps.y)) {
            float res = G.camGrid.w;
            vec3 up = vec3(0.0, (3.0 + 3.0 * rand(seed)) * res, 0.0) + randInSphere(seed) * res;
            float life = mix(G.wwC.x, G.wwC.y, rand(seed));
            steam[o] = Particle(vec4(p.pos.xyz + vec3(0.0, 0.3, 0.0), life), vec4(up, 0.0));
        }
    }
}
