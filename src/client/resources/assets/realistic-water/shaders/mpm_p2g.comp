#version 430 core
#include "common.glsl"
#include "mpm.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer Src { Particle src[]; };
layout(std430, binding = 2) readonly buffer State { float state[]; };
layout(std430, binding = 3) buffer Grid { int grid[]; };
layout(std430, binding = 4) buffer Count { int cellCount[]; };
layout(std430, binding = 5) buffer Counters { uint counters[]; };
layout(std430, binding = 6) buffer Mix { int cellMix[]; };
layout(std140, binding = 7) uniform PC { ivec4 a; ivec4 b; } pc;

// Splats particle GID_U; returns its slot-mask bit (0 for dead slots).
uint body() {
    uint i = GID_U;
    if (i >= counters[pc.a.x]) {
        return 0u;
    }
    Particle p = src[i];
    vec3 x = p.pos.xyz;
    if (p.pos.w < 0.0) {
        return 0u;
    }
    int slot = grainSlot(p.vel.w);
    uint bits = 1u << uint(slot);
    if (!inInnerBox(x)) {
        return bits;
    }
    mat3 C = mat3(0.0);
    mat3 tau = mat3(0.0);
    if (p.pos.w >= 0.5) {
        int o = int(i) * STATE_STRIDE;
        C = LOAD_MAT(state, o);
        int t = o + STATE_TAU;
        tau = mat3(state[t], state[t + 3], state[t + 4], state[t + 3], state[t + 1], state[t + 5], state[t + 4], state[t + 5], state[t + 2]);
    }
    float squeeze = C[0][0] + C[1][1] + C[2][2];
    if (squeeze < 0.0) {
        tau += MPM_IMPACT_VISCOSITY / MPM_VOLUME * squeeze * mat3(1.0);
    }
    mat3 affine = -DT * MPM_VOLUME * 4.0 * tau + C;
    vec3 v = p.vel.xyz;
    Stencil s = stencil(x);
    for (int k = 0; k < 3; k++) {
        for (int j = 0; j < 3; j++) {
            for (int ii = 0; ii < 3; ii++) {
                ivec3 c = s.base + ivec3(ii, j, k);
                if (!inBox(c)) {
                    continue;
                }
                float w = s.w[ii].x * s.w[j].y * s.w[k].z;
                vec3 dpos = vec3(ii, j, k) - s.fx;
                vec3 mom = w * (v + affine * dpos);
                int n = 4 * cellIndex(c);
                atomicAdd(grid[n], int(round(w * MASS_FP)));
                atomicAdd(grid[n + 1], int(round(mom.x * MOM_FP)));
                atomicAdd(grid[n + 2], int(round(mom.y * MOM_FP)));
                atomicAdd(grid[n + 3], int(round(mom.z * MOM_FP)));
            }
        }
    }
    ivec3 cell = ivec3(floor(x));
    if (inBox(cell)) {
        int ci = cellIndex(cell);
        atomicAdd(cellCount[ci], 1);
        if (uniformSlot() < 0) {
            atomicAdd(cellMix[4 * ci], 1);
            atomicAdd(cellMix[4 * ci + 1 + slot / 4], 1 << (8 * (slot & 3)));
        }
    }
    return bits;
}

shared uint groupSlots;

void main() {
    // Every invocation reaches both barriers: the region's slot mask is reduced per workgroup, then OR-ed into the counters.
    if (gl_LocalInvocationIndex == 0u) {
        groupSlots = 0u;
    }
    barrier();
    uint bits = body();
    if (bits != 0u) {
        atomicOr(groupSlots, bits);
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u && groupSlots != 0u) {
        atomicOr(counters[C_SLOTS], groupSlots);
    }
}
