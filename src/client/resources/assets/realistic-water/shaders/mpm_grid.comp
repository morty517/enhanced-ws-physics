#version 430 core
#include "common.glsl"
#include "mpm.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) buffer Grid { ivec4 grid[]; };
layout(std430, binding = 2) readonly buffer Static { uint staticSolid[]; };
// Fluid -> granular coupling: the overlapping fluid region's MAC velocities and particle counts.
layout(std430, binding = 3) readonly buffer WaterVel { float wvel[]; };
layout(std430, binding = 4) readonly buffer WaterCount { int wcount[]; };
// a.xyz = fluid grid size (cells), a.w = 1 if coupled; b.xyz = granular origin in fluid cells, b.w = fluid res / granular res;
// c.x = drag rate (1/s), c.y = buoyancy (fraction of gravity cancelled under water)
layout(std140, binding = 7) uniform PC { ivec4 a; vec4 b; vec4 c; } pc;

ivec3 wFaceDims(int comp) {
    return pc.a.xyz + axisVec(comp);
}

int wFaceBase(int comp) {
    int nu = (pc.a.x + 1) * pc.a.y * pc.a.z;
    int nv = pc.a.x * (pc.a.y + 1) * pc.a.z;
    return comp == 0 ? 0 : (comp == 1 ? nu : nu + nv);
}

float wSampleFace(int comp, vec3 x) {
    ivec3 d = wFaceDims(comp);
    vec3 g = clamp(x - faceOffset(comp), vec3(0.0), vec3(d - 1));
    ivec3 b = min(ivec3(floor(g)), max(d - 2, ivec3(0)));
    vec3 f = g - vec3(b);
    int base = wFaceBase(comp);
    float r = 0.0;
    for (int k = 0; k < 2; k++) {
        for (int j = 0; j < 2; j++) {
            for (int i = 0; i < 2; i++) {
                ivec3 q = b + ivec3(i, j, k);
                float w = (i == 1 ? f.x : 1.0 - f.x) * (j == 1 ? f.y : 1.0 - f.y) * (k == 1 ? f.z : 1.0 - f.z);
                r += w * wvel[base + q.x + d.x * (q.y + d.y * q.z)];
            }
        }
    }
    return r;
}

vec3 waterDrag(ivec3 c, vec3 v) {
    if (pc.a.w == 0) {
        return v;
    }
    vec3 xw = pc.b.xyz + (vec3(c) + 0.5) * pc.b.w;
    ivec3 cw = ivec3(floor(xw));
    if (any(lessThan(cw, ivec3(0))) || any(greaterThanEqual(cw, pc.a.xyz))) {
        return v;
    }
    if (wcount[cw.x + pc.a.x * (cw.y + pc.a.y * cw.z)] <= 0) {
        return v;
    }
    vec3 vw = vec3(wSampleFace(0, xw), wSampleFace(1, xw), wSampleFace(2, xw)) / pc.b.w;
    v = mix(v, vw, 1.0 - exp(-pc.c.x * DT));
    return v - G.gravityDt.xyz * DT * pc.c.y;
}

bool solid(ivec3 c) {
    return inGrid(c) && staticSolid[cellIndex(c)] != 0u;
}

vec3 slide(vec3 v, vec3 n) {
    float vn = dot(v, n);
    if (vn >= 0.0) {
        return v;
    }
    vec3 vt = v - vn * n;
    float t = length(vt);
    return t > -MPM_WALL_FRICTION * vn ? vt * (1.0 + MPM_WALL_FRICTION * vn / t) : vec3(0.0);
}

void main() {
    int t = int(GID_U);
    if (t >= G.boxMin.w) {
        return;
    }
    ivec3 c = boxCell(t);
    int i = cellIndex(c);
    ivec4 g = grid[i];
    float mass = float(g.x) / MASS_FP;
    if (mass < 1e-5) {
        grid[i] = ivec4(0);
        return;
    }
    vec3 v = waterDrag(c, vec3(g.yzw) / MOM_FP / mass + G.gravityDt.xyz * DT);
    if (solid(c)) {
        vec3 n = vec3(0.0);
        for (int a = 0; a < 3; a++) {
            ivec3 e = axisVec(a);
            n = setAxis(n, a, getAxis(n, a) + (solid(c + e) ? 0.0 : 1.0) - (solid(c - e) ? 0.0 : 1.0));
        }
        v = dot(n, n) > 0.0 ? slide(v, normalize(n)) : vec3(0.0);
    } else {
        for (int a = 0; a < 3; a++) {
            ivec3 e = axisVec(a);
            if (solid(c - e)) {
                v = slide(v, vec3(e));
            }
            if (solid(c + e)) {
                v = slide(v, -vec3(e));
            }
        }
    }
    float speed = length(v);
    if (speed > G.simB.x) {
        v *= G.simB.x / speed;
    }
    grid[i] = ivec4(floatBitsToInt(v), floatBitsToInt(mass));
}
